# ==========================================
# VERIFAI Environment Configuration
# ==========================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production-verifai-2026!
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Postgres for Production, SQLite for Local Dev)
DATABASE_URL=sqlite:///db.sqlite3

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_ALL_ORIGINS=True

# Machine Learning Model Artifact Paths (Relative to backend directory or Absolute)
ML_MODEL_PATH=../ml/fake_news_model.pkl
TFIDF_VECTORIZER_PATH=../ml/tfidf_vectorizer.pkl

# URL Ingestion Security Limits
URL_SCRAPE_TIMEOUT_SECONDS=5
MAX_URL_CONTENT_BYTES=2097152

# Rate Limiting / Throttling
PREDICTION_RATE_LIMIT=60/minute
